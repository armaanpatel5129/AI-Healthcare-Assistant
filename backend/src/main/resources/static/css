@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
:root{--primary:#167c80;--primary2:#20a39e;--dark:#123238;--text:#263b40;--muted:#71858a;--bg:#f4f9f9;--white:#fff;--border:#dce9e9;--danger:#d94b4b;--shadow:0 14px 40px rgba(18,50,56,.08)}
*{box-sizing:border-box;margin:0;padding:0}body{font-family:Inter,Arial,sans-serif;color:var(--text);background:var(--bg);min-height:100vh}a{text-decoration:none;color:var(--primary)}button,input,select,textarea{font:inherit}button{cursor:pointer}
.auth-page{background:linear-gradient(135deg,#e8f8f7,#f7fbfb);display:flex;align-items:center;justify-content:center;padding:24px}.auth-shell{width:min(1000px,100%);display:grid;grid-template-columns:1fr 1fr;background:#fff;border-radius:28px;overflow:hidden;box-shadow:var(--shadow);min-height:610px}.auth-brand{padding:65px 55px;background:linear-gradient(145deg,#0e666b,#20a39e);color:#fff;display:flex;flex-direction:column;justify-content:center}.logo{width:50px;height:50px;border-radius:15px;background:#fff;color:var(--primary);display:grid;place-items:center;font-size:25px;font-weight:800}.auth-brand h1{font-size:42px;margin:22px 0 12px}.auth-brand h1 span,.mobile-logo span{color:#aef3ed}.auth-brand p{line-height:1.7;color:#d9ffff}.feature-list{margin-top:40px;display:grid;gap:18px}.feature-list div{font-weight:600}.auth-card{padding:60px 55px;display:flex;flex-direction:column;justify-content:center}.auth-card h2{font-size:30px;margin-bottom:8px;color:var(--dark)}.muted{color:var(--muted);font-size:14px;line-height:1.6}.auth-card form{margin-top:28px}.auth-card label,.form-label{display:block;font-size:13px;font-weight:700;margin:16px 0 7px}.auth-card input,.form-control{width:100%;padding:13px 14px;border:1px solid var(--border);border-radius:11px;outline:none;background:#fbfdfd}.auth-card input:focus,.form-control:focus{border-color:var(--primary);box-shadow:0 0 0 3px #167c8015}.password-wrap{position:relative}.password-wrap input{padding-right:45px}.eye{position:absolute;right:5px;top:4px;border:0;background:transparent;padding:9px;color:var(--muted)}.btn{border:0;border-radius:11px;padding:12px 18px;font-weight:700;transition:.2s}.btn:hover{transform:translateY(-1px)}.primary{background:var(--primary);color:#fff}.secondary{background:#e8f5f4;color:var(--primary)}.danger{background:#fff0f0;color:var(--danger)}.full{width:100%;margin-top:22px}.auth-switch{text-align:center;margin-top:22px;font-size:14px}.demo-note{text-align:center;color:#9aa; font-size:11px;margin-top:22px}.mobile-logo{display:none;align-items:center;gap:10px;margin-bottom:25px}.mobile-logo .logo{width:40px;height:40px}

.sidebar{position:fixed;left:0;top:0;bottom:0;width:245px;background:#fff;border-right:1px solid var(--border);padding:25px 18px;z-index:10}.brand{display:flex;align-items:center;gap:10px;padding:0 10px 30px;font-size:21px;font-weight:800;color:var(--dark)}.brand .logo{width:40px;height:40px;border-radius:12px;font-size:19px;background:#e9f8f7}.brand span{color:var(--primary)}.nav{display:grid;gap:7px}.nav a{padding:13px 14px;border-radius:11px;color:#688086;font-weight:600;font-size:14px}.nav a:hover,.nav a.active{background:#eaf7f6;color:var(--primary)}.nav-icon{margin-right:10px}.logout{position:absolute;bottom:25px;left:18px;right:18px}.main{margin-left:245px;padding:30px;max-width:1400px}.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}.topbar h1{font-size:27px;color:var(--dark)}.user-pill{background:#fff;padding:9px 13px;border-radius:30px;border:1px solid var(--border);font-size:13px;font-weight:700}.avatar{display:inline-grid;place-items:center;width:30px;height:30px;border-radius:50%;background:#dff5f3;color:var(--primary);margin-right:7px}
.hero{background:linear-gradient(120deg,#0d666b,#21a8a1);border-radius:20px;padding:30px;color:#fff;display:flex;justify-content:space-between;align-items:center;margin-bottom:22px;overflow:hidden}.hero h2{font-size:25px;margin-bottom:8px}.hero p{opacity:.85;max-width:600px;font-size:14px}.hero-art{font-size:70px;opacity:.25}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:17px}.card{background:#fff;border:1px solid var(--border);border-radius:17px;padding:20px;box-shadow:0 5px 20px rgba(18,50,56,.035)}.stat-icon{width:42px;height:42px;border-radius:12px;background:#eaf7f6;display:grid;place-items:center;font-size:20px;margin-bottom:15px}.stat-number{font-size:25px;font-weight:800;color:var(--dark)}.stat-label{font-size:12px;color:var(--muted);margin-top:4px}.section{margin-top:23px}.section-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:13px}.section-title h3{font-size:17px;color:var(--dark)}.quick-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.quick{display:flex;gap:15px;align-items:center}.quick .qicon{font-size:27px}.quick h4{font-size:14px}.quick p{font-size:12px;color:var(--muted);margin-top:4px}
.form-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:17px}.form-group.full-row{grid-column:1/-1}.form-card{max-width:850px}.radio-row{display:flex;gap:10px;flex-wrap:wrap}.radio-row label{padding:10px 15px;border:1px solid var(--border);border-radius:10px;cursor:pointer;font-size:13px}.radio-row input{accent-color:var(--primary)}.actions{display:flex;gap:10px;margin-top:20px}
.symptom-layout{display:grid;grid-template-columns:1.5fr 1fr;gap:20px}.symptom-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:12px}.symptom-option{border:1px solid var(--border);border-radius:12px;padding:12px;display:flex;gap:9px;align-items:center;cursor:pointer;font-size:13px;background:#fff}.symptom-option:has(input:checked){border-color:var(--primary);background:#edfafa}.symptom-option input{accent-color:var(--primary)}textarea{resize:vertical;min-height:110px}.notice{padding:14px;border-radius:12px;background:#fff9e8;color:#775d18;font-size:12px;line-height:1.6}.result-score{display:flex;align-items:center;gap:20px}.score-ring{width:115px;height:115px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(var(--primary) 0 72%,#e5eeee 72%)}.score-inner{width:85px;height:85px;border-radius:50%;background:#fff;display:grid;place-items:center;text-align:center}.score-inner b{font-size:22px;color:var(--primary)}.result-box{margin-top:20px;padding:18px;border-radius:15px;background:#f1f9f8}.result-box h4{margin-bottom:8px}.tag{display:inline-block;padding:6px 9px;border-radius:20px;background:#e7f5f4;color:var(--primary);font-size:11px;font-weight:700;margin:3px}.history-table{width:100%;border-collapse:collapse}.history-table th,.history-table td{text-align:left;padding:14px 10px;border-bottom:1px solid var(--border);font-size:13px}.history-table th{color:var(--muted);font-size:11px;text-transform:uppercase}.status{padding:5px 9px;border-radius:20px;background:#e9f7ee;color:#26824c;font-size:11px;font-weight:700}
.toast{position:fixed;right:25px;bottom:25px;background:#123238;color:#fff;padding:13px 17px;border-radius:10px;box-shadow:var(--shadow);z-index:99;font-size:13px}.empty{text-align:center;padding:40px;color:var(--muted)}
@media(max-width:850px){.auth-shell{grid-template-columns:1fr}.auth-brand{display:none}.mobile-logo{display:flex}.sidebar{width:70px;padding:20px 10px}.brand{padding:0 5px 25px}.brand b,.nav a span,.logout span{display:none}.nav a{text-align:center;padding:13px 5px}.nav-icon{margin:0;font-size:18px}.logout{left:10px;right:10px}.main{margin-left:70px;padding:20px}.grid{grid-template-columns:repeat(2,1fr)}.quick-grid,.symptom-layout{grid-template-columns:1fr}.hero-art{display:none}}
@media(max-width:560px){.auth-card{padding:35px 25px}.main{padding:14px}.topbar h1{font-size:21px}.user-pill{font-size:11px}.hero{padding:22px}.grid,.form-grid,.symptom-grid{grid-template-columns:1fr}.history-wrap{overflow-x:auto}.history-table{min-width:600px}}
